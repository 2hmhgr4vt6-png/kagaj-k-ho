# ---------------------------------------------------------------------------
# Kagaj K Ho? — environment variables
# Copy to `.env` and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Prisma).
DATABASE_URL="postgresql://kagaj:kagaj@localhost:5432/kagaj_k_ho?schema=public"

# Public origin, used for canonical URLs, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign admin session cookies (HS256 JWT).
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Seed-only bootstrap admin. Change the password immediately after first login.
# The seed script refuses to run with the placeholder password outside development.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-locally"

# Optional: analytics endpoint. Events are anonymous (no PII, no IP storage).
# Leave empty to keep analytics as a no-op in local development.
NEXT_PUBLIC_ANALYTICS_ENABLED="false"

# Optional: Anthropic API key for the AI assistant, which is strictly a
# retrieval layer over verified DB content. If unset, the /api/ai/ask route
# falls back to deterministic keyword retrieval with no model call.
ANTHROPIC_API_KEY=""
